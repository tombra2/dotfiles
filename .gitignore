nvim/.config/nvim/lazy-lock.json

# Claude
claude/.claude/.credentials.json
claude/.claude/history.jsonl
claude/.claude/mcp-needs-auth-cache.json
claude/.claude/cache/
claude/.claude/backups/
claude/.claude/projects/
claude/.claude/plugins/
claude/.claude/shell-snapshots/
claude/.claude/todos/
claude/.claude/statsig/
claude/.claude/ide/
claude/.claude/sessions/
claude/.claude/file-history/
claude/.claude/Untitled

# Backup files
*.bak.[0-9]*
kitty/.config/kitty/*.bak.*
kitty/.config/kitty/kitty.local.conf

# Per-machine monitor layout (keep separate on laptop and desktop)
hypr/.config/hypr/monitors.local.lua

# Secrets/env
.env
.env.*
*.pem
*.key
id_rsa
id_ed25519
.credentials.json
*.log

# Herdr runtime data
herdr/.config/herdr/session.json

# Pi: keep only shared configuration and resources in version control
pi/.pi/*
!pi/.pi/settings.json
!pi/.pi/mcp.json
!pi/.pi/extensions/
!pi/.pi/extensions/**
!pi/.pi/skills/
!pi/.pi/skills/**
!pi/.pi/prompts/
!pi/.pi/prompts/**
!pi/.pi/themes/
!pi/.pi/themes/**
