let mapleader = " "

Plug 'tpope/vim-commentary'
set surround
set highlightedyank
set ideajoin
set quickfix
set multicursor
set which-key
set notimeout

nnoremap <leader>ce :edit ~/.ideavimrc<CR>
nnoremap <leader>so :source ~/.ideavimrc<CR>:nohlsearch<CR>
nnoremap <Esc> :nohlsearch<CR>
set clipboard=unnamed,unnamedplus
set matchpairs+=<:>
set ideajoin
set hlsearch
set smartcase
set ignorecase
set incsearch
inoremap jk <Esc>
inoremap jj <Esc>
inoremap kk <Esc>
map <Leader>r <action>(Replace)
map <Leader>ss <action>(ShowSettings)
map <Leader>gc <action>(ActivateCommitToolWindow)
nmap gi <action>(GotoImplementation)
nmap gd <action>(GotoDeclaration)
nmap gD <action>(GotoDefinition)
map <Leader><Leader> <action>(SearchEverywhere)
map <Leader>sw <action>(Switcher)

map <Leader>cc <action>(PhpNewClass)
map <Leader>cr <action>(RenameElement)
map <C-b> <action>(ActivateProjectToolWindow)
map <C-h> <action>(PreviousTab)
map <C-l> <action>(NextTab)
nmap s <Action>(flash.search)
xmap s <Action>(flash.search)
xnoremap p "_dP
map / <Action>(Find)
map <Leader>qq <action>(CloseEditor)
map <Leader>t <action>(ActivateTerminalToolWindow)
noremap u uzz
noremap J mzJ`z
nnoremap K mzK`z
nnoremap u uzz
noremap <C-d> <C-d>zz
noremap <C-u> <C-u>zz  
vmap J :m '>+1<CR>gv=gv
vmap K :m '<-2<CR>gv=gv
nmap [ <Action>(GotoNextError)
nmap ] <Action>(GotoPreviousError)



