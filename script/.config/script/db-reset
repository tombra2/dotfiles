#!/usr/bin/env bash
# reset-db-fresh.sh — immer kompletter Reset mit neuer Initialmigration

set -euo pipefail

log() { printf "[%s] %s\n" "$(date '+%H:%M:%S')" "$*"; }
c() { ddev exec php bin/console "$@"; }
ct() { ddev exec php bin/console -e test "$@"; }

log "lösche migrations/"
ddev exec rm -rf migrations/*

log "drop dev DB"
c doctrine:database:drop --if-exists --force

log "create dev DB"
c doctrine:database:create --if-not-exists

log "erstelle neue Initialmigration"
c doctrine:migrations:diff

log "führe Migration aus (dev)"
c doctrine:migrations:migrate -n

log "validiere Schema (dev)"
c doctrine:schema:validate

# TEST-DB
log "drop test DB"
ct doctrine:database:drop --if-exists --force

log "create test DB"
ct doctrine:database:create --if-not-exists

log "führe Migration aus (test)"
ct doctrine:migrations:migrate -n

log "lade Fixtures (test)"
ddev exec php bin/console --env=test doctrine:fixtures:load -n

log "validiere Schema (test)"
ct doctrine:schema:validate

log "fertig."
