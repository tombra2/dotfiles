#!/usr/bin/env bash
set -euo pipefail  # Bei Fehler sofort abbrechen

# ── Farben für Output ──────────────────────────────────────
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

log()  { echo -e "${GREEN}[✓]${NC} $1"; }
warn() { echo -e "${YELLOW}[!]${NC} $1"; }
err()  { echo -e "${RED}[✗]${NC} $1"; exit 1; }

# ── Pakete installieren ────────────────────────────────────
install_packages() {
  log "Installiere zusätzliche Pakete..."
  local packages=(
    google-chrome
    jetbrains-toolbox
    1Password
    spotify
    nextcloud-client
    element-deskop
    aether
    ddev-bin
    rclone
    thunderbird
    stow
    anki


    
  )
  yay -S --noconfirm "${packages[@]}" || err "Paketinstallation fehlgeschlagen"
}

# ── Dotfiles einrichten ────────────────────────────────────
setup_dotfiles() {
  log "Richte Dotfiles ein..."
  # Beispiel mit stow oder direkten Symlinks
}

# ── Services aktivieren ────────────────────────────────────
enable_services() {
  log "Aktiviere Services..."
  systemctl --user enable syncthing || warn "Syncthing nicht gefunden"
}

# ── Hauptablauf ────────────────────────────────────────────
main() {
  log "Starte Post-Install-Script..."
  install_packages
  setup_dotfiles
  enable_services
  log "Fertig! Bitte neu starten."
}

main "$@"
