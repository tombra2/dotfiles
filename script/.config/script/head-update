#!/bin/bash

set -e

# === LOKAL ===

echo "==> Exporting DB with ddev export-db..."
ddev export-db --file=backup.sql.gz

echo "==> Running PHPStan (composer stan)..."
if ! composer stan; then
    echo "PHPStan errors found. Aborting update."
    exit 1
fi

echo "==> Running code fixer (composer fix)..."
composer fix

echo "==> Staging all changes..."
git add .

echo "==> Committing changes..."
git commit -m "auto dev-commit"

echo "==> Pushing to remote..."
git push

# Optional: Backup auf den Server kopieren (unbedingt nötig, wenn Datenbank-Import auf dem Server gewünscht ist!)
# scp backup.sql.gz root@217.154.18.228:/root/docker-setup/symfony-app/

# === REMOTE ===

echo "==> Logging in to remote server, pulling changes, importing DB, clearing and warming cache..."

sshpass -p 'CGrTFH64' ssh -o StrictHostKeyChecking=no root@217.154.18.228 'bash -s' <<'ENDSSH'
set -e
cd docker-setup/symfony-app

echo "==> Pulling latest code..."
git pull

echo "==> Importing DB backup..."
gzip -cd backup.sql.gz | docker exec -i docker-setup-mariadb-1 mariadb --binary-mode -u root -pMw8cmk8m! db

echo "==> Clearing Symfony prod cache..."
docker exec -i docker-setup-php-1 bash -c "php bin/console cache:clear --env=prod"

echo "==> Warming up Symfony prod cache..."
docker exec -i docker-setup-php-1 bash -c "php bin/console cache:warmup --env=prod"

ENDSSH

echo "✅ Update completed!"
