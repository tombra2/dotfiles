#!/bin/bash
# Toggle the floating OpenClaw TUI window (bound to SUPER + T).
# Launches it into a hidden special workspace on first use, then just
# toggles that special workspace's visibility on every subsequent press.

set -euo pipefail

CLASS="openclawfloat"
LAUNCH_CMD=(kitty --class="$CLASS" -o background_opacity=1.0 --directory=/home/thomas/session -e tmux new-session -A -s openclaw -c /home/thomas/session openclaw tui)

window_exists() {
	hyprctl clients -j | jq -e --arg c "$CLASS" 'any(.[]; .class == $c)' >/dev/null
}

if ! window_exists; then
	setsid "${LAUNCH_CMD[@]}" >/dev/null 2>&1 &
	disown

	for _ in $(seq 1 40); do
		window_exists && break
		sleep 0.05
	done
fi

hyprctl dispatch 'hl.dsp.workspace.toggle_special("openclawfloat")' >/dev/null
