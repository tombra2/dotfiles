#!/bin/bash
# Toggle the floating OpenClaw TUI window (bound to SUPER + T).
# Launches it into a hidden special workspace on first use, then just
# toggles that special workspace's visibility on every subsequent press.

set -euo pipefail

CLASS="openclawfloat"
OPENCLAW="/home/thomas/.local/share/mise/installs/node/latest/bin/openclaw"
LAUNCH_CMD=(alacritty --class="$CLASS" -o 'window.opacity=1.0' --working-directory="$HOME" -e tmux new-session -A -s openclaw -c "$HOME" "$OPENCLAW" tui)

window_exists() {
	hyprctl clients -j | jq -e --arg c "$CLASS" 'any(.[]; .class == $c)' >/dev/null
}

if ! window_exists; then
	setsid "${LAUNCH_CMD[@]}" >/dev/null 2>&1 &
	disown

	for _ in $(seq 1 40); do
		window_exists && break
		sleep 0.05
	done
fi

hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$CLASS\")" >/dev/null
