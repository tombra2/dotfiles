#!/bin/bash
# Minimal WebApp Launcher (Hyprland/Wayland + walker)
# Thomas' slim version: only ~10 links

set -euo pipefail

# --- Konfiguration -----------------------------------------------------------
# Nutzt Chromium im App-Modus; fällt auf $BROWSER zurück falls nicht vorhanden.
BROWSER_BIN="${BROWSER:-chromium}"

# "Name|URL" je Zeile – einfach anpassen/ergänzen.
read -r -d '' WEBAPPS <<'APPS'
Mantis | https://mantis.akaryon-services.com/my_view_page.phpGmail|https://mail.google.com/
Nextcloud|https://cloud.akaryon-services.com/apps/files/
WeatherAPI|https://www.weatherapi.com/docs/
Symfony Docs|https://symfony.com/doc/current/index.html
PHP Manual|https://www.php.net/manual/en/
LazyVim|https://www.lazyvim.org/
Arch Wiki|https://wiki.archlinux.org/
Hyprland Wiki|https://wiki.hypr.land/
Thunderbird Add-ons|https://addons.thunderbird.net/
APPS
# ---------------------------------------------------------------------------

menu() {
  local options
  options="$(echo "$WEBAPPS" | awk -F'|' '{print $1}' | sed '/^\s*$/d')"
  echo -e "$options" | walker --dmenu --theme dmenu_250 -p "Web…"
}

open_web() {
  local url="$1"

  if command -v "$BROWSER_BIN" >/dev/null 2>&1; then
    # Chromium/Chrome im App-Fenster; ohne Terminalbindung starten
    if [[ "$BROWSER_BIN" == *chrom* || "$BROWSER_BIN" == *chrome* ]]; then
      setsid "$BROWSER_BIN" --new-window --app="$url" >/dev/null 2>&1 &
    else
      # generischer Fallback
      setsid "$BROWSER_BIN" --new-window "$url" >/dev/null 2>&1 &
    fi
  elif command -v xdg-open >/dev/null 2>&1; then
    setsid xdg-open "$url" >/dev/null 2>&1 &
  else
    echo "Kein Browser gefunden. Installiere z.B. chromium." >&2
    exit 1
  fi
}

pick_and_open() {
  local choice url
  choice="$(menu || true)"
  [[ -z "$choice" ]] && exit 0

  # zugehörige URL finden
  url="$(echo "$WEBAPPS" | awk -F'|' -v c="$choice" '$1==c {print $2}')"
  if [[ -n "$url" ]]; then
    open_web "$url"
  fi
}

# Direktstart per Argument: ./webapps.sh "Symfony Docs"
if [[ $# -gt 0 ]]; then
  name="$*"
  url="$(echo "$WEBAPPS" | awk -F'|' -v n="$name" '$1==n {print $2}')"
  [[ -z "$url" ]] && { echo "Unbekannte WebApp: $name" >&2; exit 1; }
  open_web "$url"
else
  pick_and_open
fi

