#!/usr/bin/env bash

set -euo pipefail

HERDR_BIN="${HERDR_BIN_PATH:-herdr}"

SEARCH_PATHS=(
  "$HOME/workspace/github.com/tombra2|1"
  "$HOME/workspace/htl/pos|1"
  "$HOME/workspace/htl/syp|1"
  "$HOME/workspace/probe|1"
  "$HOME/workspace/akaryon-development.com/brandner|1"
  "$HOME/workspace/htl/tinf|1"
  "$HOME/workspace/akaryon-development.com|1"
  "$HOME/Documents/htl|1"
  "$HOME/Dropbox/matura|1"
  "$HOME/dotfiles|0"
  "$HOME/.config/nvim|0"
  "$HOME/.config/hypr|0"
  "$HOME/.config/walker|0"
  "$HOME/.config/waybar|0"
  "$HOME/.config/tmux|0"
  "$HOME/.config/herdr|0"
)

canonical_path() {
  realpath -m -- "$1"
}

workspace_rows() {
  local workspaces workspace_id label cwd
  workspaces="$($HERDR_BIN workspace list)"

  while IFS=$'\t' read -r workspace_id label; do
    [[ -n "$workspace_id" ]] || continue
    cwd="$($HERDR_BIN pane list --workspace "$workspace_id" | jq -r '.result.panes[0].cwd // ""')"
    printf '[HERDR] %s\tworkspace\t%s\t%s\n' "$label" "$workspace_id" "$cwd"
  done < <(jq -r '.result.workspaces[] | [.workspace_id, .label] | @tsv' <<<"$workspaces")
}

directory_rows() {
  local entry root depth directory canonical
  declare -A seen=()

  for entry in "${SEARCH_PATHS[@]}"; do
    root="${entry%|*}"
    depth="${entry##*|}"
    [[ -d "$root" ]] || continue

    if [[ "$depth" == "0" ]]; then
      canonical="$(canonical_path "$root")"
      [[ -n "${seen[$canonical]:-}" ]] || printf '[DIR] %s\tdirectory\t-\t%s\n' "$canonical" "$canonical"
      seen["$canonical"]=1
      continue
    fi

    while IFS= read -r -d '' directory; do
      canonical="$(canonical_path "$directory")"
      [[ -n "${seen[$canonical]:-}" ]] && continue
      seen["$canonical"]=1
      printf '[DIR] %s\tdirectory\t-\t%s\n' "$canonical" "$canonical"
    done < <(find "$root" -mindepth 1 -maxdepth "$depth" -path '*/.git' -prune -o -type d -print0)
  done
}

focus_workspace_for_path() {
  local selected_path="$1" workspace_id cwd

  while IFS=$'\t' read -r workspace_id cwd; do
    [[ -n "$cwd" ]] || continue
    if [[ "$(canonical_path "$cwd")" == "$selected_path" ]]; then
      "$HERDR_BIN" workspace focus "$workspace_id" >/dev/null
      printf '%s\n' "$workspace_id"
      return 0
    fi
  done < <(
    while IFS= read -r workspace_id; do
      cwd="$($HERDR_BIN pane list --workspace "$workspace_id" | jq -r '.result.panes[0].cwd // ""')"
      printf '%s\t%s\n' "$workspace_id" "$cwd"
    done < <($HERDR_BIN workspace list | jq -r '.result.workspaces[].workspace_id')
  )

  return 1
}

ensure_dev_tab() {
  local workspace_id="$1" path="$2" label="$3" command="$4"
  local tabs tab_id tab_json pane_id foreground_count
  tabs="$($HERDR_BIN tab list --workspace "$workspace_id")"
  tab_id="$(jq -r --arg label "$label" '.result.tabs | map(select(.label == $label))[0].tab_id // ""' <<<"$tabs")"

  if [[ -z "$tab_id" ]]; then
    tab_json="$($HERDR_BIN tab create --workspace "$workspace_id" --cwd "$path" --label "$label" --no-focus)"
    tab_id="$(jq -r '.result.tab.tab_id' <<<"$tab_json")"
    pane_id="$(jq -r '.result.root_pane.pane_id' <<<"$tab_json")"
  else
    pane_id="$($HERDR_BIN pane list --workspace "$workspace_id" | jq -r --arg tab "$tab_id" '.result.panes | map(select(.tab_id == $tab))[0].pane_id // ""')"
  fi

  if [[ -n "$command" && -n "$pane_id" ]]; then
    foreground_count="$($HERDR_BIN pane process-info --pane "$pane_id" | jq '.result.process_info.foreground_processes | length')"
    if [[ "$foreground_count" -eq 0 ]]; then
      "$HERDR_BIN" pane run "$pane_id" "$command" >/dev/null
    fi
  fi

  printf '%s\n' "$tab_id"
}

ensure_dev_layout() {
  local workspace_id="$1" path="$2" pi_tab
  pi_tab="$(ensure_dev_tab "$workspace_id" "$path" pi 'exec pi')"
  ensure_dev_tab "$workspace_id" "$path" terminal '' >/dev/null
  "$HERDR_BIN" tab focus "$pi_tab" >/dev/null
}

create_dev_workspace() {
  local path="$1" name workspace_json workspace_id pi_tab pi_pane split_json hunk_pane
  name="$(basename "$path" | tr . _)"
  workspace_json="$($HERDR_BIN workspace create --cwd "$path" --label "$name" --focus)"
  workspace_id="$(jq -r '.result.workspace.workspace_id' <<<"$workspace_json")"
  pi_tab="$(jq -r '.result.tab.tab_id' <<<"$workspace_json")"
  pi_pane="$(jq -r '.result.root_pane.pane_id' <<<"$workspace_json")"

  "$HERDR_BIN" tab rename "$pi_tab" pi >/dev/null
  "$HERDR_BIN" pane run "$pi_pane" 'exec pi' >/dev/null
  split_json="$($HERDR_BIN pane split --pane "$pi_pane" --direction right --cwd "$path" --no-focus)"
  hunk_pane="$(jq -r '.result.pane.pane_id' <<<"$split_json")"
  "$HERDR_BIN" pane run "$hunk_pane" 'exec hunk diff --watch' >/dev/null
  "$HERDR_BIN" tab create --workspace "$workspace_id" --cwd "$path" --label terminal --no-focus >/dev/null
  "$HERDR_BIN" tab focus "$pi_tab" >/dev/null
}

attach_if_needed() {
  if [[ -z "${HERDR_ENV:-}" && -z "${HERDR_ACTIVE_WORKSPACE_ID:-}" ]]; then
    exec "$HERDR_BIN"
  fi
}

main() {
  local choice display kind workspace_id selected_path

  if [[ $# -gt 0 ]]; then
    selected_path="$(canonical_path "$1")"
    [[ -d "$selected_path" ]] || {
      printf 'Not a directory: %s\n' "$selected_path" >&2
      exit 1
    }
    if workspace_id="$(focus_workspace_for_path "$selected_path")"; then
      ensure_dev_layout "$workspace_id" "$selected_path"
    else
      create_dev_workspace "$selected_path"
    fi
    attach_if_needed
    return
  fi

  choice="$({ workspace_rows; directory_rows; } | fzf \
    --delimiter=$'\t' \
    --with-nth=1 \
    --prompt='project> ' \
    --border-label=' herdr ' \
    --preview='path={4}; if [ -d "$path" ]; then eza --tree --level=2 --color=always --icons=always "$path" 2>/dev/null || ls -la "$path"; fi')" || exit 0

  IFS=$'\t' read -r display kind workspace_id selected_path <<<"$choice"
  if [[ "$kind" == "workspace" ]]; then
    "$HERDR_BIN" workspace focus "$workspace_id" >/dev/null
  elif ! workspace_id="$(focus_workspace_for_path "$selected_path")"; then
      create_dev_workspace "$selected_path"
  fi

  attach_if_needed
}

main "$@"
